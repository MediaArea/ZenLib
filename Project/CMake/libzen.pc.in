prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@LIB_INSTALL_DIR@
includedir=@INCLUDE_INSTALL_DIR@
Unicode=@ZenLib_Unicode@
Libs_Static=@LIB_INSTALL_DIR@/libzen.a@ZenLib_PKGCONFIG_THREAD_LIBS@

Name: libzen
Version: @ZenLib_VERSION@
Description: ZenLib
Libs: -L${libdir} -len
Libs.private:@ZenLib_PKGCONFIG_THREAD_LIBS@
Cflags: -I${includedir} @ZenLib_CXXFLAGS@
